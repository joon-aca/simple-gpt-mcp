# Set these in the MCP host's environment. The server does not auto-load .env.
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_MODEL=replace-with-a-model-you-can-access

# Optional absolute state directory
# SIMPLE_GPT_MCP_DATA_DIR=/absolute/path/to/simple-gpt-mcp-data

# Optional policies (defaults shown)
# SIMPLE_GPT_MCP_TIMEOUT_MS=120000
# SIMPLE_GPT_MCP_RETENTION_DAYS=30
# SIMPLE_GPT_MCP_MAX_CONCURRENT=4
# SIMPLE_GPT_MCP_MAX_INPUT_BYTES=262144
# SIMPLE_GPT_MCP_MAX_RESULT_BYTES=262144
# SIMPLE_GPT_MCP_MAX_STORED_BYTES=67108864
# SIMPLE_GPT_MCP_MAX_SESSIONS=1000
# SIMPLE_GPT_MCP_MAX_REQUESTS=10000
